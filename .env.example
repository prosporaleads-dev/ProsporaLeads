# Local development only. Copy to .env and use a local development database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prosporaleads_dev?schema=public"
APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
JWT_SECRET=""
JWT_ISSUER="prospora-leads"
JWT_AUDIENCE="prospora-admin"

# Needed only when running pnpm admin:create.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""